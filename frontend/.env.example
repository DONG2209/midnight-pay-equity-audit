# Not read by the app in sandbox mode (see src/main.ts) — everything runs
# client-side. These are the variables you'll set when you point the verifier at
# a live Midnight network (Preprod), alongside scripts/deploy-preprod.ts.
# See README.md § "Going to Preprod".

# The network id to hint to the wallet connector, e.g. "preprod".
VITE_NETWORK_ID=preprod

# The address of your deployed Pay-Equity Audit contract (printed by
# `npm run deploy:preprod`).
VITE_CONTRACT_ADDRESS=

# Midnight indexer (public data provider) and proof-server URIs for the network
# above. See https://docs.midnight.network for current Preprod endpoints.
VITE_INDEXER_URI=
VITE_INDEXER_WS_URI=
VITE_PROOF_SERVER_URI=
